# GCP
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCS_BUCKET=your-gcp-project-id-olist-data-lake

# BigQuery datasets
BQ_RAW_DATASET=olist_raw
BQ_PROD_DATASET=olist_prod

# Kaggle credentials (new single-token format)
KAGGLE_API_TOKEN=KGAT_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Legacy format (only if not using KAGGLE_API_TOKEN above)
# KAGGLE_USERNAME=your-kaggle-username
# KAGGLE_KEY=your-kaggle-api-key

# Google credentials JSON path (place key file at keys/gcp-service-account.json)
GOOGLE_APPLICATION_CREDENTIALS=./keys/gcp-service-account.json

# Cloud Composer (only needed for Airflow deployment)
COMPOSER_REPO_ROOT_GCS=gs://your-composer-bucket/dags/ecommerce-analytics
PIPELINE_SERVICE_ACCOUNT=olist-pipeline-sa@your-gcp-project-id.iam.gserviceaccount.com
